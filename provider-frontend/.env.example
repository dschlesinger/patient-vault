PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-legacy-jwt-anon-key  # use the eyJ... key from Settings > API, not the sb_publishable_ one

# Optional: directory for dev logs (frontend.log + usb-app.log).
# Provider frontend reads this via $env/dynamic/private; the USB app also
# loads LOG_FOLDER from this file when it is not set in the shell environment.
# LOG_FOLDER=/tmp/patient-vault-logs
